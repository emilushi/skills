      "bug_class": "encoding-invariant-violation",
      "difficulty": "HARD",
      "file": "src/path.c",
      "function": "sgl_scope_set",
      "mechanism": "SGL_IS_NAME_CH is the single definition of what may appear in a scope or a name, and it excludes the separator so a joined path stays unambiguous. sgl_scope_set now exempts SGL_SEP from that macro while sgl_name_check still enforces it, so an attacker-supplied scope can carry separators and the resulting path parses as a different, deeper namespace than the one it was authorised for.",
      "attacker_control": "the value bytes of a SGL_KIND_SCOPE field in a data frame",
      "mechanism_all_of": [
        [
          "separator",
          "delimiter",
          "sgl_sep",
          "invariant",
          "inject",
          "ambiguous"
        ],
        [
          "scope",
          "sgl_scope_set",
          "path",
          "name",
          "macro",
          "sgl_is_name_ch"
        ]
      ],
      "call_path": [
        {
          "from": "sgl_feed",
          "to": "session_index"
        },
        {
          "from": "session_index",
          "to": "sgl_scope_set"
        }
      ],
      "anchor": [
        "    if (!SGL_IS_NAME_CH((unsigned char)raw[i])) {",
        "      return SGL_E_FORMAT;",
        "    }",
        "  }",
        "  memcpy(rec->scope, raw, i);"
      ],
      "replacement": [
        "    if (!SGL_IS_NAME_CH((unsigned char)raw[i]) && raw[i] != SGL_SEP) {",
        "      return SGL_E_FORMAT;",
        "    }",
