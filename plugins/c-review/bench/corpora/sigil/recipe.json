      "anchor": [
        "  value_len = (size_t)(((size_t)p[2 + name_len] << 8) | (size_t)p[3 + name_len]);",
        "  if (value_len > SGL_VALUE_MAX) {",
        "    return SGL_E_LIMIT;",
        "  }",
        "  if (avail < 4 + name_len + value_len) {"
